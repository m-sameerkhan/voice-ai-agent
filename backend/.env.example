# Groq (LLM)
GROQ_API_KEY=

# Deepgram (STT)
DEEPGRAM_API_KEY=
# Optional tuning - defaults match a typical console config (nova-2, 10ms endpointing).
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_ENDPOINTING_MS=10

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
# Optional: pin a specific voice ID so the backend doesn't need to look one up.
# Leave blank to let the frontend pick from GET /api/voices instead.
ELEVENLABS_VOICE_ID=

# CORS - the origin your Next.js frontend is served from.
# Local dev default matches `npm run dev`.
FRONTEND_ORIGIN=http://localhost:3000
